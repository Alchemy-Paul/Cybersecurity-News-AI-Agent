# Copy this file to .env and fill in your own values.
# Do NOT commit .env to git.

SLACK_WEBHOOK_URL=your_slack_webhook_url_here
OUTPUT_DIR=
MAX_STORY_COUNT=12
CRON_SCHEDULE=0 8 * * *
GENERATE_SCHEDULER_FILES=0

# Optional: email delivery via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Optional: Discord delivery
DISCORD_WEBHOOK_URL=

# Optional but recommended: free NVD API key (https://nvd.nist.gov/developers/request-an-api-key)
# Raises the NVD rate limit from 5 to 50 requests / 30s.
NVD_API_KEY=

# Optional: path to your watchlist (default: ./watchlist.txt). See watchlist.example.txt
WATCHLIST_FILE=
